---
/**
 * Custom MobileMenuToggle Component
 * Exact parity with zenso-website mobile hamburger button:
 * Minimal rounded button without floating circular drop-shadow.
 * Uses 22px stroke-based Lucide menu and close icons.
 */
---

<button
	popovertarget="starlight__sidebar"
	class="zen-menu-button sl-menu-button sl-flex md:sl-hidden print:hidden"
	type="button"
	aria-label={Astro.locals.t('menuButton.accessibleLabel')}
>
	<svg
		class="open-menu zen-burger-icon"
		xmlns="http://www.w3.org/2000/svg"
		width="22"
		height="22"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<path d="M4 6h16"></path>
		<path d="M4 12h16"></path>
		<path d="M4 18h16"></path>
	</svg>

	<svg
		class="close-menu zen-burger-icon"
		xmlns="http://www.w3.org/2000/svg"
		width="22"
		height="22"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<path d="M18 6 6 18"></path>
		<path d="m6 6 12 12"></path>
	</svg>

	<span class="sr-only">{Astro.locals.t('menuButton.accessibleLabel')}</span>
</button>

<style>
	button.zen-menu-button {
		position: fixed;
		top: calc((var(--sl-nav-height) - 2.25rem) / 2);
		inset-inline-end: var(--sl-nav-pad-x);
		z-index: var(--sl-z-index-navbar);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0.375rem;
		border: 0;
		border-radius: 4px;
		background: transparent !important;
		color: var(--sl-color-text) !important;
		box-shadow: none !important;
		cursor: pointer;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	button.zen-menu-button:hover {
		background-color: color-mix(in srgb, var(--sl-color-text) 7%, transparent) !important;
		color: var(--sl-color-text) !important;
	}

	button.zen-menu-button:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	button.zen-menu-button:has(~ :popover-open) {
		background-color: color-mix(in srgb, var(--sl-color-text) 10%, transparent) !important;
		box-shadow: none !important;
	}

	@media (min-width: 50rem) {
		button.zen-menu-button {
			display: none !important;
		}
	}

	button:has(~ :popover-open) .open-menu {
		display: none;
	}

	button:not(:has(~ :popover-open)) .close-menu {
		display: none;
	}

	.zen-burger-icon {
		width: 22px;
		height: 22px;
		display: block;
		stroke-width: 2;
	}
</style>

<style is:global>
	@layer starlight.core {
		body:has(#starlight__sidebar:popover-open) {
			overflow: hidden;
		}

		@media (min-width: 50rem) {
			body:has(#starlight__sidebar:popover-open) {
				overflow: auto;
			}
		}
	}
</style>
