---
/**
 * Mobile Drawer Footer Component
 * Matches zenso-website drawer footer aesthetic:
 * Language switcher · Theme toggle
 * External links group (GitHub, Discord, zenso.ink)
 */
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import ExternalLinks from './ExternalLinks.astro';
---

<div class="zen-mobile-footer">
	<div class="zen-mobile-controls">
		<LanguageSwitcher />
		<span aria-hidden="true" class="zen-sep">·</span>
		<ThemeToggle />
	</div>

	<div class="zen-mobile-links">
		<ExternalLinks />
	</div>
</div>

<style>
	.zen-mobile-footer {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-top: 1.25rem;
		margin-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline);
	}

	.zen-mobile-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
	}

	.zen-sep {
		user-select: none;
		color: var(--sl-color-hairline);
	}

	.zen-mobile-links {
		display: flex;
		align-items: center;
		justify-content: center;
	}
</style>
