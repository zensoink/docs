---
/**
 * External links group for Zenso Docs
 * Matching zenso-website calm e-paper aesthetic:
 * GitHub · Discord · Zenso Web (zenso.ink)
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const links = [
	{
		label: 'GitHub',
		href: 'https://github.com/zensoink',
		icon: 'github',
		title: 'Zenso GitHub Organization',
	},
	{
		label: 'Discord',
		href: 'https://discord.gg/vTjzkwz3XV',
		icon: 'discord',
		title: 'Zenso Community Discord',
	},
	{
		label: 'zenso.ink',
		href: 'https://zenso.ink',
		icon: 'external',
		title: 'Zenso Main Website',
	},
];
---

<div class:list={['zen-external-links', className]} role="group" aria-label="External resources">
	{
		links.map((link, index) => (
			<>
				{index > 0 && <span aria-hidden="true" class="zen-sep">·</span>}
				<a
					href={link.href}
					target="_blank"
					rel="noopener noreferrer"
					class="zen-ext-link"
					aria-label={link.label}
					title={link.title}
				>
					{link.icon === 'github' && (
						<svg
							class="zen-icon"
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
							<path d="M9 18c-4.51 2-5-2-7-2" />
						</svg>
					)}
					{link.icon === 'discord' && (
						<svg
							class="zen-icon zen-icon-fill"
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="currentColor"
						>
							<path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.865-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.058a.082.082 0 0 0 .031.056 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.291.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
						</svg>
					)}
					{link.icon === 'external' && (
						<svg
							class="zen-icon"
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M15 3h6v6" />
							<path d="M10 14 21 3" />
							<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
						</svg>
					)}
				</a>
			</>
		))
	}
</div>

<style>
	.zen-external-links {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.zen-sep {
		user-select: none;
		color: var(--sl-color-hairline);
		font-size: 0.75rem;
		opacity: 0.8;
	}

	.zen-ext-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.375rem;
		border-radius: 4px;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		transition: color 0.15s ease, background-color 0.15s ease;
	}

	.zen-ext-link:hover {
		color: var(--sl-color-text);
		background-color: var(--sl-color-accent-low);
	}

	.zen-icon {
		width: 1rem;
		height: 1rem;
		display: block;
	}

	.zen-icon-fill {
		fill: currentColor;
	}
</style>
