name = "zenso-subpath-router"
main = "worker.js"
compatibility_date = "2026-01-01"

routes = [
  { pattern = "zenso.ink/*", zone_name = "zenso.ink" },
  { pattern = "www.zenso.ink/*", zone_name = "zenso.ink" }
]

[vars]
DOCS_ORIGIN = "https://zenso-docs.pages.dev"
MAIN_ORIGIN = "https://zenso-website.pages.dev"
