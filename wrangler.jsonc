{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zenso-docs",
  "compatibility_date": "2026-04-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "zenso.ink/en/docs*", "zone_name": "zenso.ink" },
    { "pattern": "zenso.ink/pl/docs*", "zone_name": "zenso.ink" },
    { "pattern": "zenso.ink/ja/docs*", "zone_name": "zenso.ink" },
    { "pattern": "zenso.ink/docs*", "zone_name": "zenso.ink" },
    { "pattern": "zenso.ink/_docs_assets/*", "zone_name": "zenso.ink" },
    { "pattern": "zenso.ink/pagefind/*", "zone_name": "zenso.ink" },
    { "pattern": "zenso.ink/docs-sitemap*.xml", "zone_name": "zenso.ink" }
  ]
}
